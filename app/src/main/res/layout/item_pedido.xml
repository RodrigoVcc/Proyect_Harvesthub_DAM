<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_pedidos"
    android:layout_margin="12dp"
    card_view:cardBackgroundColor="#F1F1F1"
    card_view:cardCornerRadius="25dp"
    card_view:cardElevation="6dp"
    card_view:contentPadding="4dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rv_pedidos_imagenes"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"/>

        <TextView
            android:id="@+id/textTitulo_producto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/rv_pedidos_imagenes"
            android:text="Producto"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingLeft="20dp"
            android:paddingTop="8dp"
            android:textColor="@android:color/black"/>


        <TextView
            android:id="@+id/txtview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textTitulo_producto"
            android:layout_marginStart="17dp"
            android:layout_marginTop="14dp"
            android:layout_toEndOf="@+id/rv_pedidos_imagenes"
            android:paddingLeft="5dp"
            android:text="Total: $"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPrecio_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textTitulo_producto"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@+id/txtview"
            android:paddingLeft="5dp"
            android:text="00.0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="y/MM/dd"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/txtview"
            android:layout_toEndOf="@+id/rv_pedidos_imagenes"/>




    </RelativeLayout>

</androidx.cardview.widget.CardView>