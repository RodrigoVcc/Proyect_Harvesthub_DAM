<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_cart"
    android:layout_margin="12dp"
    card_view:cardBackgroundColor="#F1F1F1"
    card_view:cardCornerRadius="25dp"
    card_view:cardElevation="6dp"
    card_view:contentPadding="4dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/item_id"
            android:layout_width="142dp"
            android:layout_height="98dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />
        <TextView
            android:id="@+id/textTitulo_producto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/item_id"
            android:text="Producto"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingLeft="20dp"
            android:paddingTop="8dp"
            android:textColor="@android:color/black"/>


        <ImageView
            android:id="@+id/imageView"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_below="@id/textTitulo_producto"
            android:layout_alignStart="@id/textTitulo_producto"
            android:layout_marginStart="139dp"
            android:layout_marginTop="39dp"
            card_view:srcCompat="@drawable/carrito" />

        <TextView
            android:id="@+id/txvPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textTitulo_producto"
            android:layout_marginStart="17dp"
            android:layout_marginTop="14dp"
            android:layout_toEndOf="@+id/item_id"
            android:paddingLeft="5dp"
            android:text="Precio: $"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textTitulo_producto"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@+id/txvPrecio"
            android:paddingLeft="5dp"
            android:text="00.0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/add"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@id/textTitulo_producto"
            android:layout_alignStart="@id/txvPrecio"
            android:layout_marginStart="159dp"
            android:layout_marginTop="43dp"
            card_view:srcCompat="@drawable/agregar" />
        <ImageView
            android:id="@+id/quitar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@id/textTitulo_producto"
            android:layout_alignStart="@id/txvPrecio"
            android:layout_marginStart="90dp"
            android:layout_marginTop="43dp"
            card_view:srcCompat="@drawable/quitar" />

        <ImageView
            android:id="@+id/basura"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@id/textTitulo_producto"
            android:layout_alignStart="@id/txvPrecio"
            android:layout_marginStart="160dp"
            android:layout_marginTop="-36dp"
            card_view:srcCompat="@drawable/basura" />


    </RelativeLayout>

</androidx.cardview.widget.CardView>