<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_card_notificaion"
    android:layout_margin="12dp"
    card_view:cardBackgroundColor="#F1F1F1"
    card_view:cardCornerRadius="25dp"
    card_view:cardElevation="6dp"
    card_view:contentPadding="4dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textTitulo_notificacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notificacion"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/txtDescripcion_noti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textTitulo_notificacion"
            android:layout_marginTop="5dp"
            android:text="Descripcion"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>