<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="230dp"
    android:layout_height="315dp"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_margin="12dp"
    card_view:cardBackgroundColor="#F1F1F1"
    card_view:cardCornerRadius="25dp"
    card_view:cardElevation="6dp"
    card_view:contentPadding="4dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:id="@+id/item_id"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            />
        <TextView
            android:id="@+id/textTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_id"
            android:layout_alignStart="@id/item_id"
            android:text="Producto"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/textDescrp"
            android:layout_width="167dp"
            android:layout_height="123dp"
            android:layout_below="@id/textTitulo"
            android:layout_alignStart="@id/textTitulo"
            android:layout_marginStart="0dp"
            android:layout_marginTop="2dp"
            android:paddingTop="8dp"
            android:text="Frijoles nutritivos y de la mejor calidad perfectos para sopas, guisos o como base de tus platillos."
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="51dp"
            android:layout_height="50dp"
            android:layout_below="@id/textDescrp"
            android:layout_alignStart="@id/textDescrp"
            android:layout_marginStart="159dp"
            android:layout_marginTop="-24dp"
            card_view:srcCompat="@drawable/carrito_add" />


    </RelativeLayout>

</androidx.cardview.widget.CardView>