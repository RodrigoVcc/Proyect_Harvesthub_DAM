<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.CarritoFragment">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/verde_menu"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Carrito"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/avatar_usuario"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/usuario" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_carrito"
            android:layout_width="match_parent"
            android:layout_height="384dp" />

        <RelativeLayout
            android:id="@+id/header2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/crd_chekout"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:padding="16dp"
                android:backgroundTint="@color/verde_claro">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/txvSubTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="12dp"
                        android:text="Subtotal"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <!-- LISTVIEW ENTRE SUBTOTAL Y TOTAL -->
                    <ListView
                        android:id="@+id/listaResumen"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_toEndOf="@+id/txvSubTotal"
                        android:divider="@android:color/darker_gray"
                        android:dividerHeight="1dp"/>

                    <TextView
                        android:id="@+id/txvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/listaResumen"
                        android:layout_marginTop="20dp"
                        android:text="Total"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginStart="12dp"/>

                    <TextView
                        android:id="@+id/txvTotal_sum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$00.00"
                        android:textSize="25sp"
                        android:layout_marginTop="15dp"
                        android:layout_below="@id/listaResumen"
                        android:layout_toEndOf="@+id/txvTotal"
                        android:layout_marginLeft="180dp"/>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

        </RelativeLayout>

        <Button
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:text="Pagar Ahora"
            android:textColor="@color/black"
            android:backgroundTint="@color/verde_claro"/>

    </LinearLayout>


</FrameLayout>